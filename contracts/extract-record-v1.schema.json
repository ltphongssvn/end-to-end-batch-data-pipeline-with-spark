{
  "$defs": {
    "DecisionLimits": {
      "additionalProperties": false,
      "description": "The limits the policy applied, as returned by OPA.\n\nValidated rather than trusted: the policy is a separate artifact that can be\nedited independently, so its output crosses a boundary into this process and\nis checked like any other external input.",
      "properties": {
        "allowed_methods": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Methods",
          "type": "array"
        },
        "free_space_headroom": {
          "minimum": 0,
          "title": "Free Space Headroom",
          "type": "number"
        },
        "max_compression_ratio": {
          "minimum": 0,
          "title": "Max Compression Ratio",
          "type": "number"
        },
        "max_member_bytes": {
          "minimum": 0,
          "title": "Max Member Bytes",
          "type": "integer"
        },
        "max_members": {
          "minimum": 0,
          "title": "Max Members",
          "type": "integer"
        },
        "max_total_bytes": {
          "minimum": 0,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "required_digest": {
          "title": "Required Digest",
          "type": "string"
        }
      },
      "required": [
        "max_member_bytes",
        "max_total_bytes",
        "max_members",
        "max_compression_ratio",
        "allowed_methods",
        "free_space_headroom",
        "required_digest"
      ],
      "title": "DecisionLimits",
      "type": "object"
    },
    "ExtractRecordVersion": {
      "const": "extract-record/v1",
      "type": "string"
    },
    "ExtractionDecision": {
      "additionalProperties": false,
      "description": "One authorization decision, suitable for an audit record.",
      "properties": {
        "allow": {
          "title": "Allow",
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/DecisionLimits"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "allow",
        "policy_version",
        "reasons",
        "limits"
      ],
      "title": "ExtractionDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sidecar attesting which bytes were extracted, from which archive.",
  "properties": {
    "actor": {
      "anyOf": [
        {
          "description": "Non-empty filesystem path, recorded for provenance",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor"
    },
    "archive": {
      "description": "Non-empty filesystem path, recorded for provenance",
      "minLength": 1,
      "title": "Archive",
      "type": "string"
    },
    "archive_sha256": {
      "description": "SHA-256 digest, 64 lowercase hex digits",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "crc32": {
      "description": "CRC-32 checksum, unsigned 32-bit",
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Crc32",
      "type": "integer"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractionDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extracted_at": {
      "description": "Timezone-aware timestamp; naive values are rejected",
      "format": "date-time",
      "title": "Extracted At",
      "type": "string"
    },
    "member": {
      "description": "Archive member name, no path separators",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "title": "Member",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "description": "Non-empty filesystem path, recorded for provenance",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "$ref": "#/$defs/ExtractRecordVersion",
      "default": "extract-record/v1"
    },
    "sha256": {
      "description": "SHA-256 digest, 64 lowercase hex digits",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "description": "Size in bytes",
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "archive",
    "member",
    "size_bytes",
    "sha256",
    "archive_sha256",
    "crc32",
    "extracted_at"
  ],
  "title": "ExtractionRecord",
  "type": "object"
}
